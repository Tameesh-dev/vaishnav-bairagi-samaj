# ---------------- polls (मतदान) ----------------
@app.route("/poll", methods=["GET", "POST"])
def poll_page():
    db = get_db()
    poll = db.execute("SELECT * FROM polls WHERE active=1 ORDER BY id DESC LIMIT 1").fetchone()
    results = []
    total = 0
    voted = None
    if poll:
        opts = [o.strip() for o in poll["options"].split("\n") if o.strip()]
        counts = [0] * len(opts)
        for v in db.execute("SELECT option_index, COUNT(*) c FROM poll_votes WHERE poll_id=? GROUP BY option_index", (poll["id"],)).fetchall():
            if v["option_index"] < len(counts):
                counts[v["option_index"]] = v["c"]
        total = sum(counts)
        results = list(zip(opts, counts))
    if request.method == "POST":
        f = request.form
        if poll and f.get("option") is not None:
            try:
                idx = int(f["option"])
                if 0 <= idx < len(results):
                    db.execute("INSERT INTO poll_votes (poll_id, option_index, voter_name) VALUES (?,?,?)",
                               (poll["id"], idx, f.get("name", "").strip() or "अनामिक"))
                    db.commit()
                    flash("🙏 Dhanyavaad! Aapka mat dardh ho gaya!", "success")
                    resp = redirect(url_for("poll_page"))
                    resp.set_cookie("voted_%d" % poll["id"], "1", max_age=365 * 24 * 3600)
                    return resp
            except ValueError:
                pass
        return redirect(url_for("poll_page"))
    return render_template("poll.html", poll=poll, results=results, total=total)

