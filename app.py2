def _admin_token():
    """Daily rotating key, works even where browsers block cookies."""
    today = datetime.date.today().isoformat()
    return hashlib.sha256((app.secret_key + today).encode()).hexdigest()[:24]

def login_required(f):
    @wraps(f)
    def wrapper(*a, **kw):
        if session.get("admin"):
            return f(*a, **kw)
        if request.values.get("k") == _admin_token():
            return f(*a, **kw)
        return redirect(url_for("admin_login"))
    return wrapper

# ---------------------------------------------------------------- public pages
@app.route("/")
def home():
    db = get_db()
    stats = {
        "members": db.execute("SELECT COUNT(*) c FROM members WHERE status='approved'").fetchone()["c"],
        "villages": db.execute("SELECT COUNT(DISTINCT village) c FROM members WHERE status='approved'").fetchone()["c"],
        "professions": db.execute("SELECT COUNT(DISTINCT profession) c FROM members WHERE status='approved'").fetchone()["c"],
        "states": db.execute("SELECT COUNT(DISTINCT state) c FROM members WHERE status='approved'").fetchone()["c"],
    }
    latest = db.execute("""SELECT name, village, district, state, profession
                           FROM members WHERE status='approved'
                           ORDER BY id DESC LIMIT 3""").fetchall()
    notices = db.execute("SELECT text FROM announcements ORDER BY id DESC LIMIT 10").fetchall()
    yt = yatra_settings(db)
    yt_days = yatra_days(yt["date"])
    return render_template("index.html", stats=stats, latest=latest, notices=notices,
                           birthdays=upcoming_birthdays(db), yatra=yt, yatra_days=yt_days)

def upcoming_birthdays(db, days=30):
    """Agle `days` dinon ke andar jinki DOB hai — approved members."""
    rows = db.execute("SELECT name, village, dob FROM members WHERE status='approved' AND dob IS NOT NULL AND dob != ''").fetchall()
    today = datetime.date.today()
    out = []
    for r in rows:
        try:
            y, m, d = [int(x) for x in r["dob"].split("-")]
        except Exception:
            continue
        for yr in (today.year, today.year + 1):
            try:
                bday = datetime.date(yr, m, d)
            except ValueError:
                continue
            if bday >= today:
                delta = (bday - today).days
                if delta <= days:
                    out.append({"name": r["name"], "village": r["village"],
                                "date": bday.strftime("%d %b"), "days": delta})
                break
    out.sort(key=lambda x: x["days"])
    return out[:8]

def yatra_settings(db=None):
    d = {"name": "कुलदेवी माँ कमला — गुजरात दर्शन यात्रा",
         "date": "2027-01-14",
         "place": "माँ कमला माता मंदिर, गुजरात",
         "desc": "हमारे समाज की कुलदेवी माँ कमला के चरणों में दर्शन और आशीर्वाद के लिए सभी बहनें निमंत्रित हैं। माता के दरबार में हाजिरी भरें — जय कमला माता! 🚩",
         "plan": "1. प्रस्थान: बुलडाणा से — सुबह 6:00 बजे\n2. रास्ते में चाय-नाश्ता\n3. माँ कमला माता मंदिर पहुँचकर दर्शन + आरती\n4. प्रसाद वितरण और सामूहिक भोजन\n5. दोपहर बाद वापसी प्रस्थान",
         "checklist": "नौवारी/साडी एवं गजरा-हार\nपूजा सामग्री — अक्षता, हल्दी-कुंकू, कपूर, दीप\nप्रसाद पैक करके साथ लाएँ\nआधार कार्ड / ID\nगर्म कपड़े (जनवरी की ठंड!)\nअपनी दवाइयाँ\nपानी की बोतल + हल्का नाश्ता"}
    db = db or get_db()
    rows = db.execute("SELECT key, value FROM yatra_settings").fetchall()
    if rows:
        for r in rows:
            d[r["key"]] = r["value"]
    else:
        # pehli baar — default values ko db mein bhi save karo
        for k, v in d.items():
            db.execute("INSERT OR IGNORE INTO yatra_settings (key, value) VALUES (?,?)", (k, v))
        db.commit()
    return d

def yatra_days(date_str):
    if not date_str:
        return None
    try:
        y, m, dd = [int(x) for x in date_str.split("-")]
        delta = (datetime.date(y, m, dd) - datetime.date.today()).days
        return delta if delta >= 0 else None
    except ValueError:
        return None

@app.route("/yatra", methods=["GET", "POST"])
def yatra_page():
    db = get_db()
    yt = yatra_settings(db)
    if request.method == "POST":
        f = request.form
        name = (f.get("name") or "").strip()
        if not name:
            flash("Naam zaroori hai! ✍️", "error")
            return redirect(url_for("yatra_page") + "#reg")
        try:
            persons = max(1, int(f.get("persons") or 1))
        except ValueError:
            persons = 1
        db.execute("INSERT INTO yatra_regs (name, village, phone, persons, notes) VALUES (?,?,?,?,?)",
                   (name, (f.get("village") or "").strip(), (f.get("phone") or "").strip(),
                    persons, (f.get("notes") or "").strip()))
        db.commit()
        flash("🙏 Jay Maa Kamaladevi! Aapka naam yatra mein dardh ho gaya!", "success")
        return redirect(url_for("yatra_page") + "?done=1")
    regs = db.execute("SELECT * FROM yatra_regs ORDER BY created_at DESC").fetchall()
    total_persons = db.execute("SELECT COALESCE(SUM(persons),0) s FROM yatra_regs").fetchone()["s"]
    return render_template("yatra.html", yatra=yt, regs=regs,
                           total=len(regs), total_persons=total_persons,
                           days=yatra_days(yt["date"]),
                           done=request.args.get("done"))

