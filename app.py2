@app.route("/admin/downloads", methods=["POST"])
@login_required
def upload_download():
    f = request.files.get("doc")
    title = request.form.get("title", "").strip()
    if f and f.filename and title:
        ext = os.path.splitext(f.filename)[1].lower()
        if ext != ".pdf":
            flash("Sirf PDF files / PDF only", "error")
            return redirect(url_for("admin_dashboard", k=_admin_token()) + "#downloads")
        fname = "d_%d.pdf" % int(datetime.datetime.now().timestamp())
        f.save(os.path.join(DL_DIR, fname))
        get_db().execute("INSERT INTO downloads (title, filename) VALUES (?,?)", (title, fname))
        get_db().commit()
    else:
        flash("Title aur PDF dono chahiye", "error")
    return redirect(url_for("admin_dashboard", k=_admin_token()) + "#downloads")

# ---- yatra ----
@app.route("/admin/yatra", methods=["POST"])
@login_required
def save_yatra():
    db = get_db()
    for key in ("name", "date", "place", "desc", "plan", "checklist"):
        val = (request.form.get(key) or "").strip()
        db.execute("INSERT INTO yatra_settings (key, value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                   (key, val))
    db.commit()
    flash("🚩 Yatra details save ho gayi! Homepage mein dikhegi.", "success")
    return redirect(url_for("admin_dashboard", k=_admin_token()) + "#yatra")

@app.route("/admin/yatra/regs/<int:rid>/delete", methods=["POST"])
@login_required
def delete_yatra_reg(rid):
    db = get_db()
    db.execute("DELETE FROM yatra_regs WHERE id=?", (rid,))
    db.commit()
    flash("Yatra registration hata diya.", "success")
    return redirect(url_for("admin_dashboard", k=_admin_token()) + "#yatra")

@app.route("/admin/downloads/<int:did>/delete", methods=["POST"])
@login_required
def delete_download(did):
    row = get_db().execute("SELECT filename FROM downloads WHERE id=?", (did,)).fetchone()
    if row:
        try:
            os.remove(os.path.join(DL_DIR, row["filename"]))
        except OSError:
            pass
        get_db().execute("DELETE FROM downloads WHERE id=?", (did,))
        get_db().commit()
    return redirect(url_for("admin_dashboard", k=_admin_token()) + "#downloads")

# ---- polls ----
@app.route("/admin/polls", methods=["POST"])
@login_required
def add_poll():
    f = request.form
    q = f.get("question", "").strip()
    opts = f.get("options", "").strip()
    if q and opts:
        get_db().execute("UPDATE polls SET active=0")
        get_db().execute("INSERT INTO polls (question, options) VALUES (?,?)", (q, opts))
        get_db().commit()
    return redirect(url_for("admin_dashboard", k=_admin_token()) + "#polls")

@app.route("/admin/polls/<int:pid>/close", methods=["POST"])
@login_required
def close_poll(pid):
    get_db().execute("UPDATE polls SET active=0 WHERE id=?", (pid,))
    get_db().commit()
    return redirect(url_for("admin_dashboard", k=_admin_token()) + "#polls")

init_db()  # idempotent — safe under gunicorn too

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8000)))
