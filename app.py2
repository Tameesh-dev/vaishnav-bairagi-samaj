#!/usr/bin/env python3
"""Vaishnav Bairagi Samaj — Community Website
Flask + SQLite. Public site + member registration + admin panel.
All CSS/JS/fonts/images are inlined into each page so the site works
even in environments that only allow top-level HTML documents.
"""
import os, re, io, base64, sqlite3, hashlib, datetime
from functools import wraps
from flask import (Flask, request, jsonify, render_template, redirect,
                   url_for, flash, session, g)
from PIL import Image

BASE = os.path.dirname(os.path.abspath(__file__))
DB = os.path.join(BASE, "database.db")

ADMIN_USER = os.environ.get("ADMIN_USER", "admin")
ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "bairagi123")

app = Flask(__name__)
app.secret_key = os.environ.get("SECRET_KEY", "vbsamaj-secret-2026")

# ---- SINGLE-FILE BUNDLE: templates loaded from memory (no files needed) ----
import base64 as _b64i
from jinja2 import DictLoader
_TEMPLATES_B64 = {'about.html': '', 'admin.html': '', 'base.html': '', 'certificate.html': '', 'committee.html': '', 'contact.html': '', 'directory.html': '', 'downloads.html': '', 'events.html': '', 'gallery.html': '', 'id_card.html': '', 'index.html': '', 'login.html': '', 'poll.html': '', 'register.html': '', 'schemes.html': '', 'stories.html': '', 'thankyou.html': '', 'yatra.html': ''}
app.jinja_loader = DictLoader({k: _b64i.b64decode(v).decode("utf-8") for k, v in _TEMPLATES_B64.items()})

# ---------------------------------------------------------------- inline assets
def _b64(path, mime):
    with open(path, "rb") as f:
        return "data:" + mime + ";base64," + base64.b64encode(f.read()).decode()

def build_assets():
    """SINGLE-FILE: everything embedded — no static files needed."""
    import base64 as _b64
    css = '/* ================================================================\n   वैष्णव बैरागी समाज — Warm Forest Green Premium Theme\n   ================================================================ */\n:root {\n  --g-950: #2B1207;\n  --g-900: #4A1E08;\n  --g-800: #B45309;   /* primary forest */\n  --g-700: #D97706;\n  --g-600: #F59E0B;\n  --g-300: #FBD9A5;\n  --g-100: #FBEEDD;\n  --cream: #F5F1E6;\n  --cream-2: #FBF8F0;\n  --gold: #C9A227;\n  --gold-soft: #EAD08B;\n  --orange: #E8630F;\n  --ink: #2C1A0D;\n  --muted: #7E6852;\n  --line: #EADFCB;\n  --radius: 16px;\n  --shadow-sm: 0 2px 10px rgba(43, 18, 7, .07);\n  --shadow-md: 0 10px 30px rgba(43, 18, 7, .12);\n  --shadow-lg: 0 22px 60px rgba(43, 18, 7, .18);\n  --font-disp: "Rozha One", "Fraunces", Georgia, serif;\n  --font-body: "Noto Deva", "Inter", system-ui, "Segoe UI", sans-serif;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody {\n  font-family: var(--font-body);\n  background: var(--cream);\n  color: var(--ink);\n  line-height: 1.65;\n  -webkit-font-smoothing: antialiased;\n}\nimg { max-width: 100%; display: block; }\na { color: var(--g-700); text-decoration: none; }\na:hover { color: var(--g-800); }\n.container { width: min(1180px, 92%); margin: 0 auto; }\n.center { text-align: center; }\n\nh1, h2, h3 { font-family: var(--font-disp); font-weight: 400; line-height: 1.25; color: var(--g-900); }\n\n/* ---------- reveal animation ---------- */\n.reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }\n.reveal.visible { opacity: 1; transform: none; }\n\n/* ================================================================ header */\n.site-header {\n  position: sticky; top: 0; z-index: 50;\n  background: linear-gradient(180deg, var(--g-950), var(--g-900));\n  border-bottom: 1px solid rgba(201, 162, 39, .35);\n  box-shadow: 0 6px 24px rgba(10, 33, 24, .35);\n}\n.header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .42rem 0; }\n.brand { display: flex; align-items: center; gap: .8rem; }\n.brand-logo { width: 46px; height: 46px; border-radius: 50%; box-shadow: 0 0 0 2px var(--gold), 0 4px 14px rgba(0,0,0,.4); }\n.brand-text { display: flex; flex-direction: column; line-height: 1.15; }\n.brand-hi { font-family: var(--font-disp); font-size: 1.18rem; color: #FDF9EE; }\n.brand-en { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-soft); }\n\n.site-nav { display: flex; align-items: center; gap: 1.15rem; }\n.site-nav a { color: #FBEEDD; font-size: .95rem; display: flex; flex-direction: column; align-items: center; line-height: 1.2; padding: .35rem .1rem; position: relative; }\n.site-nav a small { font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(251,233,221,.55); }\n.site-nav a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: -2px; height: 2px; background: var(--gold); transition: right .3s ease; }\n.site-nav a:hover::after, .site-nav a.active::after { right: 0; }\n.site-nav a.active { color: #fff; }\n.site-nav a.active small { color: var(--gold-soft); }\n.nav-cta {\n  background: linear-gradient(135deg, var(--gold), #A98716);\n  color: #2A2104 !important; font-weight: 700;\n  padding: .55rem 1.15rem !important; border-radius: 999px;\n  box-shadow: 0 4px 16px rgba(201,162,39,.4);\n}\n.nav-cta::after { display: none; }\n.nav-cta:hover { transform: translateY(-1px); }\n\n.nav-toggle { display: none; background: none; border: 0; cursor: pointer; padding: .5rem; }\n.nav-toggle span { display: block; width: 26px; height: 2.5px; background: #FBEEDD; margin: 5px 0; border-radius: 2px; }\n\n/* ================================================================ flash */\n.flash-wrap { margin-top: 1rem; }\n.flash { padding: .9rem 1.3rem; border-radius: 12px; margin-bottom: .6rem; font-size: .95rem; box-shadow: var(--shadow-sm); }\n.flash-success { background: var(--g-100); color: var(--g-900); border: 1px solid var(--g-300); }\n.flash-error { background: #FCE8E4; color: #8C2F16; border: 1px solid #F0B9AC; }\n\n/* ================================================================ hero */\n.hero {\n  position: relative; overflow: hidden; color: #F2EBD8;\n  background:\n    radial-gradient(1000px 500px at 85% -10%, rgba(217,119,6,.35), transparent 60%),\n    radial-gradient(700px 400px at -10% 110%, rgba(201,162,39,.18), transparent 55%),\n    linear-gradient(160deg, var(--g-950) 0%, var(--g-900) 45%, var(--g-800) 100%);\n}\n.hero-pattern {\n  position: absolute; inset: 0; opacity: .5; pointer-events: none;\n  background-image: url("data:image/svg+xml,%3Csvg width=\'72\' height=\'72\' viewBox=\'0 0 72 72\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cpath d=\'M36 10c7 9 7 17 0 26-7-9-7-17 0-26z\' fill=\'none\' stroke=\'rgba(220,239,226,.06)\' stroke-width=\'1.2\'/%3E%3Ccircle cx=\'36\' cy=\'58\' r=\'2\' fill=\'rgba(201,162,39,.07)\'/%3E%3C/svg%3E");\n}\n.hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 2rem; align-items: center; padding: 3.2rem 0 3.4rem; position: relative; }\n.eyebrow {\n  display: inline-block; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase;\n  color: var(--gold-soft); margin-bottom: .8rem;\n  padding-bottom: .5rem; border-bottom: 2px solid rgba(201,162,39,.5);\n}\n.eyebrow-dark { color: var(--g-700); border-color: var(--gold); }\n.hero-title { font-size: clamp(2rem, 5vw, 3.15rem); color: #FDF9EE; margin-bottom: .8rem; }\n.text-gold { color: var(--gold-soft); }\n.hero-sub { font-size: 1rem; max-width: 32rem; color: #D8E7DC; margin-bottom: 1.2rem; }\n.hero-sub em { display: block; font-size: .85rem; color: rgba(216,231,220,.6); margin-top: .4rem; font-family: var(--font-body); }\n.hero-actions { display: flex; gap: .8rem; flex-wrap: nowrap; }\n.hero-note { margin-top: .7rem; font-size: .85rem; color: rgba(216,231,220,.6); }\n\n.hero-emblem { position: relative; display: grid; place-items: center; }\n.emblem-img { width: min(240px, 58vw); border-radius: 50%; box-shadow: 0 0 0 3px rgba(201,162,39,.85), 0 30px 80px rgba(0,0,0,.5); position: relative; z-index: 2; }\n.emblem-ring {\n  position: absolute; width: min(300px, 72vw); aspect-ratio: 1; border-radius: 50%;\n  border: 1.5px dashed rgba(234,208,139,.5);\n  animation: spin 46s linear infinite;\n}\n.emblem-ring::before, .emblem-ring::after {\n  content: "✦"; position: absolute; font-size: 1.1rem; color: var(--gold-soft);\n}\n.emblem-ring::before { top: 6%; left: 14%; }\n.emblem-ring::after { bottom: 8%; right: 12%; }\n@keyframes spin { to { transform: rotate(360deg); } }\n\n/* ================================================================ buttons */\n.btn {\n  display: inline-block; font-family: var(--font-body); font-weight: 600; font-size: .95rem; white-space: nowrap;\n  padding: .75rem 1.5rem; border-radius: 999px; border: 0; cursor: pointer;\n  transition: transform .25s ease, box-shadow .25s ease; text-align: center;\n}\n.btn:hover { transform: translateY(-2px); }\n.btn-gold { background: linear-gradient(135deg, var(--gold), #A98716); color: #2A2104; box-shadow: 0 8px 24px rgba(201,162,39,.45); }\n.btn-gold:hover { color: #1C1502; box-shadow: 0 12px 30px rgba(201,162,39,.6); }\n.btn-primary { background: var(--g-800); color: #F3EFE0; box-shadow: 0 8px 24px rgba(140,60,10,.35); }\n.btn-primary:hover { background: var(--g-700); color: #fff; }\n.btn-outline { border: 1.6px solid rgba(234,208,139,.8); color: #F2EBD8; background: transparent; }\n.btn-outline:hover { background: rgba(234,208,139,.12); }\n.btn-outline-dark { border: 1.6px solid var(--g-700); color: var(--g-800); background: transparent; }\n.btn-outline-dark:hover { background: var(--g-100); }\n.btn-lg { font-size: .98rem; padding: .85rem 1.8rem; }\n.btn-sm { font-size: .85rem; padding: .5rem 1.1rem; }\n\n/* ================================================================ stats */\n.stats-band { background: var(--cream-2); border-block: 1px solid var(--line); }\n.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding: 1.8rem 0; }\n.stat { text-align: center; position: relative; }\n.stat + .stat::before { content: ""; position: absolute; left: 0; top: 15%; bottom: 15%; width: 1px; background: var(--line); }\n.stat-num { display: block; font-family: var(--font-disp); font-size: clamp(2rem, 4.5vw, 3rem); color: var(--g-800); }\n.stat-num::after { content: "+"; color: var(--gold); font-size: .6em; margin-left: .1em; }\n.stat-label { font-size: .9rem; color: var(--muted); line-height: 1.35; display: block; margin-top: .2rem; }\n.stat-label small { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; }\n\n/* ================================================================ sections */\n.section { padding: 3.4rem 0; }\n.section-tint { background: var(--cream-2); border-block: 1px solid var(--line); }\n.section-head { text-align: center; max-width: 620px; margin: 0 auto 2.2rem; }\n.section-head h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); margin-bottom: .6rem; }\n.section-sub { color: var(--muted); }\n\n/* pillars */\n.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }\n.pillar-card {\n  background: #fff; border: 1px solid var(--line); border-radius: var(--radius);\n  padding: 1.8rem 1.5rem; text-align: center; box-shadow: var(--shadow-sm);\n  transition: transform .3s ease, box-shadow .3s ease; position: relative; overflow: hidden;\n}\n.pillar-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--g-800), var(--gold)); }\n.pillar-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }\n.pillar-icon {\n  width: 74px; height: 74px; margin: 0 auto 1.2rem; border-radius: 50%;\n  display: grid; place-items: center; color: var(--g-800);\n  background: radial-gradient(circle at 30% 25%, var(--g-100), #fff 70%);\n  border: 1px solid var(--g-300);\n}\n.pillar-icon svg { width: 40px; height: 40px; }\n.pillar-card h3 { font-size: 1.45rem; margin-bottom: .55rem; }\n.pillar-card p { color: var(--muted); font-size: .97rem; }\n\n/* steps */\n.steps { display: flex; align-items: stretch; justify-content: center; gap: 1rem; margin-bottom: 2.6rem; }\n.step {\n  background: #fff; border: 1px solid var(--line); border-radius: var(--radius);\n  padding: 2rem 1.7rem; max-width: 300px; flex: 1; text-align: center; box-shadow: var(--shadow-sm);\n}\n.step-num {\n  display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;\n  background: linear-gradient(135deg, var(--g-800), var(--g-600)); color: #F3EFE0;\n  font-family: var(--font-disp); font-size: 1.5rem; margin-bottom: 1rem;\n  box-shadow: 0 8px 18px rgba(140,60,10,.3);\n}\n.step h3 { font-size: 1.3rem; margin-bottom: .4rem; }\n.step p { color: var(--muted); font-size: .93rem; }\n.step-arrow { align-self: center; color: var(--gold); font-size: 1.6rem; }\n\n/* ================================================================ members */\n.member-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.3rem; margin-bottom: 2.4rem; }\n.member-card {\n  background: #fff; border: 1px solid var(--line); border-radius: var(--radius);\n  padding: 1.8rem 1.5rem 1.5rem; text-align: center; box-shadow: var(--shadow-sm);\n  transition: transform .3s ease, box-shadow .3s ease;\n}\n.member-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--g-300); }\n.member-avatar {\n  width: 66px; height: 66px; margin: 0 auto 1rem; border-radius: 50%;\n  display: grid; place-items: center; font-family: var(--font-disp); font-size: 1.9rem; color: #FFF6E6;\n  background: radial-gradient(circle at 30% 25%, #F08C3E, var(--orange) 75%);\n  box-shadow: 0 0 0 3px #F7E9D2, 0 6px 16px rgba(232,99,15,.35);\n}\n.member-name { font-size: 1.28rem; margin-bottom: .35rem; }\n.member-place { display: inline-flex; align-items: center; gap: .3rem; color: var(--muted); font-size: .9rem; margin-bottom: .7rem; }\n.member-prof {\n  display: inline-block; background: var(--g-100); color: var(--g-800);\n  font-size: .82rem; font-weight: 600; padding: .3rem .9rem; border-radius: 999px;\n}\n\n/* filter bar */\n.filter-bar {\n  display: flex; gap: .9rem; flex-wrap: wrap; justify-content: center;\n  background: #fff; border: 1px solid var(--line); border-radius: var(--radius);\n  padding: 1.2rem; box-shadow: var(--shadow-sm); margin-bottom: 1.2rem;\n}\n.search-box {\n  flex: 1 1 320px; display: flex; align-items: center; gap: .6rem;\n  border: 2px solid var(--g-300); border-radius: 999px; padding: .6rem 1.2rem;\n  background: var(--cream-2); color: var(--muted); transition: border-color .25s, box-shadow .25s;\n}\n.search-box:focus-within { border-color: var(--g-600); box-shadow: 0 0 0 4px rgba(217,119,6,.15); }\n.search-box input { border: 0; outline: 0; background: transparent; flex: 1; font: inherit; color: var(--ink); }\n.filter-select {\n  border: 2px solid var(--g-300); border-radius: 999px; padding: .6rem 1.1rem;\n  font: inherit; color: var(--ink); background: var(--cream-2); cursor: pointer; max-width: 230px;\n}\n.filter-select:focus { outline: none; border-color: var(--g-600); }\n.result-count { text-align: center; color: var(--muted); font-size: .92rem; margin-bottom: 1.8rem; }\n.result-count b { color: var(--g-800); }\n\n.empty-state { text-align: center; padding: 4rem 1rem; color: var(--muted); }\n.empty-icon { font-size: 3rem; margin-bottom: .6rem; }\n.empty-state h3 { font-size: 1.5rem; margin-bottom: .4rem; }\n\n/* ================================================================ page head */\n.page-head {\n  background:\n    radial-gradient(700px 300px at 80% -20%, rgba(217,119,6,.25), transparent 60%),\n    linear-gradient(180deg, var(--g-100), var(--cream));\n  padding: 2.6rem 0 2rem; text-align: center; border-bottom: 1px solid var(--line);\n}\n.page-head h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); margin-bottom: .5rem; }\n.page-sub { color: var(--muted); max-width: 560px; margin: 0 auto; }\n.page-sub em { font-style: normal; font-size: .85rem; }\n\n/* ================================================================ forms */\n.form-wrap { max-width: 780px; margin: 0 auto; }\n.reg-form {\n  background: #fff; border: 1px solid var(--line); border-radius: 20px;\n  padding: 2.6rem; box-shadow: var(--shadow-md);\n}\n.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem 1.4rem; margin-bottom: 1.6rem; }\n.form-field { display: flex; flex-direction: column; gap: .4rem; }\n.form-field.span-2 { grid-column: span 2; }\n.form-field label { font-weight: 600; font-size: .95rem; color: var(--g-900); }\n.form-field label b { color: var(--orange); }\n.form-field label small { color: var(--muted); font-weight: 400; font-size: .78rem; margin-left: .25rem; }\n.form-field input, .form-field select, .form-field textarea {\n  font: inherit; color: var(--ink); background: var(--cream-2);\n  border: 2px solid var(--line); border-radius: 12px; padding: .75rem 1rem;\n  transition: border-color .25s, box-shadow .25s;\n}\n.form-field input:focus, .form-field select:focus, .form-field textarea:focus {\n  outline: none; border-color: var(--g-600); box-shadow: 0 0 0 4px rgba(217,119,6,.15);\n}\n.form-field textarea { resize: vertical; }\n.privacy-note {\n  background: var(--g-100); border: 1px solid var(--g-300); border-radius: 12px;\n  padding: .9rem 1.2rem; font-size: .88rem; color: var(--g-900); margin-bottom: 1.6rem;\n}\n.privacy-note em { font-style: normal; color: var(--muted); font-size: .8rem; }\n\n.success-card {\n  background: #fff; border: 1px solid var(--g-300); border-radius: 20px;\n  padding: 3.2rem 2.4rem; text-align: center; box-shadow: var(--shadow-md);\n}\n.success-icon { width: 86px; height: 86px; margin: 0 auto 1.4rem; color: var(--g-600); }\n.success-card h2 { font-size: 1.9rem; margin-bottom: .8rem; }\n.success-card p { color: var(--muted); margin-bottom: 1rem; }\n.success-card .hero-actions { margin-top: 1.6rem; }\n\n/* ================================================================ about */\n.about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: start; }\n.about-copy h2 { font-size: 1.8rem; margin: 1.4rem 0 .7rem; }\n.about-copy h2:first-child { margin-top: 0; }\n.about-copy p { margin-bottom: 1rem; color: #35493F; }\n.about-copy em { font-style: normal; color: var(--muted); font-size: .9rem; display: block; }\n.about-side { display: grid; gap: 1.4rem; position: sticky; top: 96px; }\n.side-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.8rem; box-shadow: var(--shadow-sm); }\n.side-card h4 { font-family: var(--font-disp); font-size: 1.25rem; color: var(--g-800); margin-bottom: .9rem; }\n.side-tint { background: linear-gradient(160deg, var(--g-800), var(--g-700)); color: #F3EFE0; border: 0; }\n.side-tint h4 { color: var(--gold-soft); }\n.side-tint small { color: rgba(243,239,224,.7); }\n.values-list { list-style: none; display: grid; gap: .55rem; font-size: .97rem; }\n\n/* ================================================================ events */\n.timeline { max-width: 800px; margin: 0 auto; display: grid; gap: 1.4rem; }\n.event-card {\n  display: flex; gap: 1.5rem; background: #fff; border: 1px solid var(--line);\n  border-radius: var(--radius); padding: 1.6rem 1.8rem; box-shadow: var(--shadow-sm);\n  transition: transform .3s ease, box-shadow .3s ease;\n}\n.event-card:hover { transform: translateX(6px); box-shadow: var(--shadow-md); }\n.event-date {\n  flex: 0 0 88px; text-align: center; border-radius: 14px; padding: .8rem .4rem;\n  background: linear-gradient(160deg, var(--g-800), var(--g-600)); color: #F3EFE0; align-self: flex-start;\n}\n.event-day { display: block; font-family: var(--font-disp); font-size: 2rem; line-height: 1; }\n.event-month { font-size: .8rem; color: var(--gold-soft); }\n.event-month small { color: rgba(243,239,224,.6); }\n.event-body h3 { font-size: 1.4rem; margin-bottom: .35rem; }\n.event-body p { color: var(--muted); font-size: .95rem; }\n.event-loc { display: flex; align-items: center; gap: .35rem; margin-top: .5rem; color: var(--g-700) !important; font-weight: 600; font-size: .88rem !important; }\n\n/* ================================================================ contact */\n.contact-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 2.2rem; align-items: start; }\n.contact-info { display: grid; gap: 1.2rem; }\n.info-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem 1.7rem; box-shadow: var(--shadow-sm); }\n.info-card h4 { font-family: var(--font-disp); font-size: 1.15rem; color: var(--g-800); margin-bottom: .4rem; }\n.info-card p { color: var(--muted); font-size: .95rem; }\n\n/* ================================================================ cta */\n.cta-banner {\n  background:\n    radial-gradient(600px 260px at 50% -40%, rgba(201,162,39,.25), transparent 60%),\n    linear-gradient(150deg, var(--g-950), var(--g-800));\n  color: #F3EFE0; text-align: center; padding: 4.2rem 0;\n}\n.cta-inner h2 { color: #FDF9EE; font-size: clamp(1.7rem, 3.6vw, 2.4rem); margin-bottom: .5rem; }\n.cta-inner p { color: rgba(243,239,224,.75); margin-bottom: 1.8rem; }\n\n/* ================================================================ footer */\n.site-footer { background: var(--g-950); color: #CFE3D4; margin-top: 0; }\n.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2.4rem; padding: 3.4rem 0 2.4rem; }\n.footer-brand { display: flex; align-items: center; gap: .9rem; font-family: var(--font-disp); font-size: 1.2rem; color: #FDF9EE; margin-bottom: 1rem; }\n.footer-brand img { width: 52px; height: 52px; border-radius: 50%; box-shadow: 0 0 0 2px var(--gold); }\n.footer-tag { color: rgba(251,233,221,.65); font-size: .92rem; }\n.footer-col h4 { color: var(--gold-soft); font-family: var(--font-disp); font-size: 1.05rem; margin-bottom: 1rem; }\n.footer-col a { display: block; color: #CFE3D4; font-size: .93rem; margin-bottom: .5rem; }\n.footer-col a:hover { color: #fff; }\n.footer-bar { border-top: 1px solid rgba(251,233,221,.15); }\n.footer-bar-inner { display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 0; font-size: .85rem; color: rgba(251,233,221,.6); flex-wrap: wrap; gap: .6rem; }\n.admin-link { color: rgba(251,233,221,.5); border: 1px solid rgba(251,233,221,.2); padding: .25rem .8rem; border-radius: 999px; font-size: .78rem; }\n.admin-link:hover { color: var(--gold-soft); border-color: var(--gold); }\n\n/* ================================================================ login */\n.login-section { min-height: 62vh; display: grid; place-items: center; }\n.login-card {\n  background: #fff; border: 1px solid var(--line); border-radius: 20px;\n  box-shadow: var(--shadow-md); padding: 2.6rem; width: min(400px, 92%);\n  display: grid; gap: 1rem; text-align: center;\n}\n.login-card form { display: grid; gap: .9rem; text-align: left; }\n.login-logo { width: 76px; height: 76px; margin: 0 auto; border-radius: 50%; }\n.login-sub { color: var(--muted); font-size: .9rem; margin-top: -.6rem; }\n\n/* ================================================================ admin */\n.admin-head { text-align: left; padding: 2.2rem 0; }\n.admin-head-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }\n.admin-head h1 { font-size: 2.1rem; }\n.admin-section { padding-top: 2.2rem; }\n.admin-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; margin-bottom: 2rem; }\n.astat {\n  background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.3rem 1.4rem;\n  display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-sm); font-size: .9rem; color: var(--muted);\n}\n.astat small { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }\n.astat-num { font-family: var(--font-disp); font-size: 2.2rem; color: var(--g-800); }\n.astat-pending { border-left: 5px solid var(--gold); }\n.astat-ok { border-left: 5px solid var(--g-600); }\n\n.admin-panel { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.8rem 2rem; margin-bottom: 2rem; }\n.admin-panel h2 { font-size: 1.5rem; margin-bottom: 1.2rem; }\n.admin-panel h2 small { font-size: .8rem; color: var(--muted); font-family: var(--font-body); }\n.table-wrap { overflow-x: auto; }\n.admin-table { width: 100%; border-collapse: collapse; font-size: .92rem; }\n.admin-table th {\n  text-align: left; padding: .7rem .8rem; background: var(--g-800); color: #F3EFE0;\n  font-weight: 600; white-space: nowrap;\n}\n.admin-table th:first-child { border-radius: 10px 0 0 0; }\n.admin-table th:last-child { border-radius: 0 10px 0 0; }\n.admin-table td { padding: .7rem .8rem; border-bottom: 1px solid var(--line); vertical-align: middle; }\n.admin-table tr:hover td { background: var(--cream-2); }\n.actions { display: flex; gap: .4rem; }\n.btn-mini {\n  border: 0; border-radius: 9px; width: 34px; height: 34px; font-size: .95rem; cursor: pointer;\n  display: grid; place-items: center; transition: transform .2s;\n}\n.btn-mini:hover { transform: scale(1.12); }\n.btn-mini.ok { background: var(--g-600); color: #fff; }\n.btn-mini.warn { background: #E9B44C; color: #3A2A00; }\n.btn-mini.del { background: #F6E3DE; color: #A33320; }\n.admin-empty { color: var(--muted); padding: .8rem 0; }\n.admin-empty em { font-style: normal; font-size: .85rem; }\n.admin-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }\n\n.event-form { display: grid; gap: .7rem; margin-bottom: 1.4rem; }\n.event-form input, .event-form textarea {\n  font: inherit; padding: .65rem 1rem; border: 2px solid var(--line); border-radius: 10px; background: var(--cream-2); color: var(--ink);\n}\n.event-form input:focus, .event-form textarea:focus { outline: none; border-color: var(--g-600); }\n.ev-row, .rej-row, .msg-row {\n  display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;\n  padding: .8rem 0; border-bottom: 1px dashed var(--line);\n}\n.ev-row small, .msg-row small { color: var(--muted); }\n.msg-row p { margin-top: .3rem; color: #35493F; font-size: .92rem; }\n.msg-date { font-size: .75rem; }\n.rejected-box { margin-top: 1.2rem; font-size: .9rem; }\n.rejected-box summary { cursor: pointer; color: var(--muted); }\n\n/* ================================================================ responsive */\n@media (max-width: 940px) {\n  .hero-grid { grid-template-columns: 1fr; text-align: center; gap: 1.6rem; padding: 2.2rem 0 2.6rem; }\n  .hero-sub, .hero-actions { margin-inline: auto; justify-content: center; }\n  .pillars { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }\n  .steps { flex-direction: column; align-items: center; }\n  .step-arrow { transform: rotate(90deg); }\n  .about-grid, .contact-grid, .admin-2col { grid-template-columns: 1fr; }\n  .about-side { position: static; }\n  .footer-grid { grid-template-columns: 1fr; gap: 1.6rem; }\n  .admin-stats { grid-template-columns: repeat(2, 1fr); }\n}\n@media (max-width: 760px) {\n  .nav-toggle { display: block; }\n  .site-nav {\n    position: fixed; inset: 70px 0 auto 0; flex-direction: column; gap: .2rem;\n    background: var(--g-950); padding: 1.2rem 0 1.6rem; border-bottom: 2px solid var(--gold);\n    transform: translateY(-130%); transition: transform .35s ease;\n    box-shadow: 0 24px 40px rgba(0,0,0,.4);\n  }\n  .site-nav.open { transform: none; }\n  .site-nav a { padding: .7rem; }\n  .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 1.6rem 0; }\n  .stat + .stat::before { display: none; }\n  .form-grid { grid-template-columns: 1fr; }\n  .form-field.span-2 { grid-column: auto; }\n  .reg-form { padding: 1.6rem; }\n  .event-card { flex-direction: column; gap: 1rem; }\n  .brand-hi { font-size: 1.05rem; }\n  .emblem-img{width:170px!important}\n  .emblem-ring{width:212px!important}\n  .hero-title{font-size:2rem!important}\n  .section{padding:2.6rem 0!important}\n\n  .admin-stats { grid-template-columns: repeat(2, 1fr); }\n}\n\n/* ================= dental-style admin dashboard ================= */\n.dash-body{background:#EEF2EC}\n.dash-shell{display:grid;grid-template-columns:248px 1fr;min-height:100vh}\n.dash-side{background:linear-gradient(180deg,var(--g-950),var(--g-900));color:#FBEEDD;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;padding:1.2rem 1rem;gap:1.2rem}\n.dash-brand{display:flex;gap:.7rem;align-items:center;padding-bottom:1rem;border-bottom:1px solid rgba(201,162,39,.3)}\n.dash-brand img{width:44px;height:44px;border-radius:50%;box-shadow:0 0 0 2px var(--gold)}\n.dash-brand b{display:block;font-family:var(--font-disp);font-size:1.05rem;color:#FDF9EE}\n.dash-brand small{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-soft)}\n.dash-nav{display:flex;flex-direction:column;gap:.25rem}\n.dash-nav a{display:flex;align-items:center;gap:.6rem;color:#FBEEDD;padding:.6rem .8rem;border-radius:10px;font-size:.92rem}\n.dash-nav a:hover{background:rgba(255,255,255,.08);color:#fff}\n.dash-nav a.active{background:rgba(201,162,39,.18);color:var(--gold-soft)}\n.badge{margin-left:auto;background:var(--gold);color:#2A2104;font-size:.7rem;font-weight:700;border-radius:999px;padding:.1rem .5rem}\n.dash-side-foot{margin-top:auto;display:grid;gap:.45rem}\n.dash-side-foot a{color:rgba(220,239,226,.8);font-size:.88rem;border:1px solid rgba(220,239,226,.2);padding:.55rem .8rem;border-radius:10px;text-align:center}\n.dash-side-foot a:hover{background:rgba(255,255,255,.08)}\n.dash-main{padding:1.6rem 1.8rem 3rem;max-width:1150px}\n.dash-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.4rem;flex-wrap:wrap;gap:.8rem}\n.dash-top h1{font-size:1.7rem;margin-bottom:0}\n.dash-top p{color:var(--muted);font-size:.86rem;margin:0}\n.dash-admin{background:#fff;border:1px solid var(--line);border-radius:999px;padding:.45rem 1rem;font-size:.85rem;color:var(--g-800);box-shadow:var(--shadow-sm)}\n.dash-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.4rem}\n.dash-stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.1rem 1.2rem;display:flex;gap:.9rem;align-items:center;box-shadow:var(--shadow-sm)}\n.dash-stat .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font-size:1.3rem;flex-shrink:0}\n.dash-stat .num{font-family:var(--font-disp);font-size:1.7rem;line-height:1.1;color:var(--g-900)}\n.dash-stat .lbl{font-size:.78rem;color:var(--muted);line-height:1.3}\n.dash-stat .lbl em{font-style:normal;color:#9DB2A6;font-size:.7rem}\n.ic-amber{background:#FFF1D6}.ic-green{background:#DCF0E2}.ic-red{background:#FBE3DE}.ic-blue{background:#E2ECFB}\n.dash-card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-sm);padding:1.3rem 1.4rem;margin-bottom:1.3rem}\n.dash-card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:.5rem}\n.dash-card-head h2{font-size:1.25rem;margin:0}\n.count-pill{background:var(--g-100);color:var(--g-800);border-radius:999px;font-size:.8rem;font-weight:700;padding:.2rem .8rem}\n.dtable{width:100%;border-collapse:collapse;font-size:.9rem}\n.dtable th{background:var(--g-800);color:#F3EFE0;text-align:left;padding:.65rem .7rem;font-weight:600;white-space:nowrap}\n.dtable th:first-child{border-radius:10px 0 0 0}.dtable th:last-child{border-radius:0 10px 0 0}\n.dtable td{padding:.65rem .7rem;border-bottom:1px solid var(--line);vertical-align:middle}\n.dtable tr:hover td{background:var(--cream-2)}\n.chip{display:inline-block;font-size:.75rem;font-weight:700;border-radius:999px;padding:.18rem .7rem}\n.chip.pending{background:#FFF1D6;color:#B07A00}\n.chip.ok{background:#DCF0E2;color:#2D6A4F}\n.chip.no{background:#FBE3DE;color:#B23B20}\n.dash-2col{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem}\n.dash-empty{text-align:center;color:var(--muted);padding:1.6rem .5rem;font-size:.95rem}\n.dash-empty .big{font-size:2rem;display:block;margin-bottom:.3rem}\n@media (max-width:980px){\n  .dash-shell{grid-template-columns:1fr}\n  .dash-side{position:static;height:auto;border-bottom:2px solid var(--gold)}\n  .dash-nav{flex-direction:row;overflow-x:auto;padding-bottom:.2rem}\n  .dash-nav a{white-space:nowrap}\n  .dash-cards{grid-template-columns:repeat(2,1fr)}\n  .dash-2col{grid-template-columns:1fr}\n  .dash-main{padding:1.1rem}\n}\n@media (max-width:520px){.dash-cards{grid-template-columns:1fr 1fr}.dash-stat .num{font-size:1.4rem}}\n\n/* ============ FEATURES: notices / committee / gallery / rsvp ============ */\n.notice-strip{padding:1.6rem 0 0}\n.notice-board{background:rgba(255,255,255,.9);border:1px solid var(--line);border-left:6px solid var(--orange,#E8630F);\n  border-radius:16px;padding:.85rem 1.1rem;display:flex;align-items:flex-start;gap:1rem;\n  box-shadow:0 6px 22px rgba(43,18,7,.08)}\n.notice-flag{flex:none;background:linear-gradient(135deg,var(--g-700),var(--g-800));color:#FBEEDD;\n  font-size:.78rem;font-weight:800;letter-spacing:.08em;padding:.42rem .8rem;border-radius:999px;margin-top:.15rem}\n.notice-list{min-width:0}\n.notice-list p{margin:.12rem 0 .3rem;font-size:.92rem;color:var(--ink)}\n.notice-list p:last-child{margin-bottom:.1rem}\n.notice-dot{color:var(--gold);margin-right:.3rem}\n\n.committee-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.2rem}\n.committee-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:1.8rem 1.3rem 1.5rem;\n  text-align:center;box-shadow:var(--shadow-sm);transition:transform .25s ease,box-shadow .25s ease;position:relative}\n.committee-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}\n.committee-card::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:64px;height:4px;\n  background:linear-gradient(90deg,var(--gold),var(--g-700));border-radius:0 0 6px 6px}\n.comm-avatar{width:72px;height:72px;margin:0 auto .8rem;border-radius:50%;display:grid;place-items:center;\n  background:radial-gradient(circle at 35% 30%,var(--g-600),var(--g-800));color:#FBEEDD;\n  font-size:1.7rem;font-weight:800;border:3px solid var(--gold-soft)}\n.comm-role{display:inline-block;background:var(--g-100);color:var(--g-800);font-size:.72rem;font-weight:800;\n  letter-spacing:.08em;padding:.3rem .75rem;border-radius:999px;margin-bottom:.5rem}\n.comm-name{font-size:1.08rem;margin-bottom:.35rem}\n.comm-place{display:flex;align-items:center;justify-content:center;gap:.3rem;color:var(--muted);font-size:.85rem}\n.comm-phone{display:inline-flex;align-items:center;gap:.35rem;margin-top:.55rem;color:var(--g-700);\n  font-weight:700;font-size:.86rem;background:var(--g-100);padding:.4rem .9rem;border-radius:999px;transition:background .2s}\n.comm-phone:hover{background:var(--g-300)}\n\n.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem}\n.gallery-item{margin:0;border-radius:18px;overflow:hidden;box-shadow:var(--shadow-sm);\n  border:1px solid var(--line);background:#fff;transition:transform .25s ease,box-shadow .25s ease;cursor:pointer}\n.gallery-item:hover{transform:translateY(-5px) scale(1.01);box-shadow:var(--shadow-lg)}\n.gallery-item img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;transition:transform .5s ease}\n.gallery-item:hover img{transform:scale(1.06)}\n.gallery-item figcaption{padding:.7rem 1rem;font-size:.85rem;color:var(--muted)}\n\n.rsvp-box{margin-top:.9rem;border:1px dashed rgba(217,119,6,.5);border-radius:14px;background:var(--g-100)}\n.rsvp-box summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;\n  gap:.8rem;padding:.65rem 1rem;font-size:.85rem;flex-wrap:wrap}\n.rsvp-box summary::-webkit-details-marker{display:none}\n.rsvp-count{color:var(--ink)}\n.rsvp-count b{color:var(--g-800);font-size:1rem}\n.rsvp-cta{background:linear-gradient(135deg,var(--g-700),var(--g-800));color:#FBEEDD;font-weight:800;\n  font-size:.78rem;padding:.4rem .85rem;border-radius:999px;white-space:nowrap}\n.rsvp-form{display:flex;gap:.6rem;padding:0 1rem .9rem;flex-wrap:wrap}\n.rsvp-form input{flex:1;min-width:130px;padding:.6rem .85rem;border:1px solid var(--line);border-radius:10px;\n  font:inherit;font-size:.88rem;background:#fff}\n.rsvp-form input:focus{outline:none;border-color:var(--g-600);box-shadow:0 0 0 3px rgba(217,119,6,.15)}\n.rsvp-form .btn{font-size:.82rem;padding:.6rem 1.1rem}\n@media (max-width:520px){.rsvp-form .btn{width:100%}}\n\n/* ============ DASHBOARD: new feature sections ============ */\n.inline-add{display:flex;gap:.6rem;padding-bottom:1rem;margin-bottom:.5rem;border-bottom:1px solid var(--line);flex-wrap:wrap}\n.inline-add input[type="text"]{flex:1;min-width:200px;padding:.65rem .95rem;border:1px solid var(--line);border-radius:12px;font:inherit;font-size:.9rem;background:#fff}\n.inline-add input[type="text"]:focus{outline:none;border-color:var(--g-600);box-shadow:0 0 0 3px rgba(217,119,6,.15)}\n.inline-add .btn{white-space:nowrap}\n.file-inp{flex:1;min-width:170px;padding:.5rem .8rem;border:1px dashed var(--g-600);border-radius:12px;background:var(--g-100);font-size:.82rem;cursor:pointer}\n.comm-form{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;padding-bottom:1rem;margin-bottom:.5rem;border-bottom:1px solid var(--line)}\n.comm-form input,.comm-form select{padding:.6rem .9rem;border:1px solid var(--line);border-radius:12px;font:inherit;font-size:.88rem;background:#fff;width:100%}\n.comm-form input:focus,.comm-form select:focus{outline:none;border-color:var(--g-600);box-shadow:0 0 0 3px rgba(217,119,6,.15)}\n.comm-form .btn{grid-column:1/-1;justify-self:start}\n.chip.role{background:var(--g-100);color:var(--g-800);font-size:.7rem}\n.chip.rsvp{background:#FDEBD0;color:#B45309;font-size:.72rem}\n.admin-gal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.8rem;padding-top:.4rem}\n.admin-gal-item{border-radius:14px;overflow:hidden;border:1px solid var(--line);background:#fff;box-shadow:var(--shadow-sm)}\n.admin-gal-item img{width:100%;aspect-ratio:1;object-fit:cover;display:block}\n.admin-gal-cap{display:flex;justify-content:space-between;align-items:center;gap:.4rem;padding:.45rem .6rem}\n.admin-gal-cap small{font-size:.72rem;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.btn-mini.idc{display:inline-grid;place-items:center;background:#FDEBD0;color:#B45309;text-decoration:none}\n.btn-mini.idc:hover{background:#FBD9A5}\n@media (max-width:520px){.comm-form{grid-template-columns:1fr}}\n\n/* ============ NEW FEATURES v2 ============ */\n/* lang toggle */\n.lang-toggle{background:linear-gradient(135deg,var(--g-700),var(--g-800));color:#FBEEDD;border:0;border-radius:999px;\n  padding:.45rem .95rem;font:inherit;font-size:.8rem;font-weight:800;cursor:pointer;margin-left:.5rem;\n  box-shadow:0 4px 14px rgba(43,18,7,.25);flex:none;transition:transform .15s ease}\n.lang-toggle:active{transform:scale(.94)}\n@media (max-width:760px){.lang-toggle{position:absolute;right:64px;top:1.05rem;font-size:.72rem;padding:.4rem .8rem}}\n\n/* birthday strip */\n.bday-strip{padding:1rem 0 0}\n.bday-board{background:rgba(255,255,255,.95);border:1px solid var(--line);border-left:6px solid var(--gold, #C9A227);\n  border-radius:16px;padding:.85rem 1.1rem;display:flex;align-items:flex-start;gap:1rem;flex-wrap:wrap;\n  box-shadow:0 6px 22px rgba(43,18,7,.08)}\n.bday-flag{flex:none;background:linear-gradient(135deg,var(--gold),#A98716);color:#2A2104;\n  font-size:.78rem;font-weight:800;padding:.42rem .8rem;border-radius:999px;margin-top:.15rem}\n.bday-list{display:flex;flex-wrap:wrap;gap:.5rem}\n.bday-item{background:var(--g-100);border:1px solid rgba(217,119,6,.25);\n  padding:.36rem .85rem;border-radius:999px;font-size:.85rem;color:var(--ink)}\n.bday-item small{color:var(--muted);margin-left:.2rem}\n\n/* explore tiles */\n.explore-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem}\n.explore-tile{background:#fff;border:1px solid var(--line);border-radius:18px;padding:1.4rem 1rem 1.1rem;text-align:center;\n  text-decoration:none;color:var(--ink);transition:transform .25s,box-shadow .25s}\n.explore-tile:hover{transform:translateY(-5px);box-shadow:var(--shadow-md)}\n.explore-tile .explore-ic{font-size:1.8rem;display:block;margin-bottom:.5rem}\n.explore-tile b{display:block;font-size:.92rem}\n.explore-tile small{display:block;color:var(--muted);font-size:.7rem;margin-top:.2rem}\n\n/* stories */\n.stories-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.3rem}\n.story-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:1.8rem 1.4rem 1.4rem;position:relative;\n  transition:transform .25s,box-shadow .25s}\n.story-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg)}\n.story-card::before{content:"";position:absolute;top:0;left:24px;width:60px;height:4px;\n  background:linear-gradient(90deg,var(--gold),var(--g-700));border-radius:0 0 6px 6px}\n.story-quote{font-size:3rem;color:var(--g-300);line-height:1;margin-bottom:.4rem;font-family:Georgia,serif}\n.story-text{color:var(--ink);line-height:1.75;font-size:.95rem;min-height:100px}\n.story-person{display:flex;align-items:center;gap:.7rem;margin-top:1.1rem;padding-top:1rem;border-top:1px dashed var(--line)}\n.story-person b{font-size:.92rem}\n.story-person small{color:var(--muted);font-size:.78rem}\n.story-avatar{width:42px;height:42px;border-radius:50%;flex:none;display:grid;place-items:center;\n  background:radial-gradient(circle at 35% 30%,var(--g-600),var(--g-800));color:#FBEEDD;font-weight:800;font-size:1rem;\n  border:2px solid var(--gold-soft)}\n\n/* schemes */\n.schemes-list{display:grid;gap:1rem;max-width:800px;margin:0 auto}\n.scheme-card{display:flex;gap:1rem;align-items:flex-start;background:#fff;border:1px solid var(--line);\n  border-radius:18px;padding:1.3rem 1.3rem 1.2rem;transition:box-shadow .2s,transform .2s}\n.scheme-card:hover{box-shadow:var(--shadow-md);transform:translateX(4px)}\n.scheme-ic{font-size:1.9rem;flex:none;width:52px;height:52px;display:grid;place-items:center;\n  background:var(--g-100);border-radius:14px;border:1px solid var(--line)}\n.scheme-body{flex:1}\n.scheme-body h3{font-size:1.05rem;margin-bottom:.3rem}\n.scheme-body p{color:var(--muted);font-size:.88rem;line-height:1.65}\n.scheme-card .btn{flex:none;margin-top:.2rem}\n\n/* downloads */\n.dl-list{display:grid;gap:.7rem;max-width:700px;margin:0 auto}\n.dl-row{display:flex;align-items:center;gap:.9rem;background:#fff;border:1px solid var(--line);\n  border-radius:14px;padding:.85rem 1.1rem;transition:box-shadow .2s}\n.dl-row:hover{box-shadow:var(--shadow-sm)}\n.dl-fileic{font-size:1.6rem;flex:none}\n.dl-info{flex:1;min-width:0}\n.dl-info b{font-size:.95rem}\n.dl-info small{color:var(--muted);font-size:.75rem}\n\n/* poll */\n.poll-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:1.8rem 1.5rem;position:relative;overflow:hidden}\n.poll-q{font-size:1.3rem;margin-bottom:1.2rem;text-align:center;color:var(--g-900)}\n.poll-form{display:grid;gap:.6rem;margin-bottom:1.2rem}\n.poll-opt{display:flex;align-items:center;gap:.8rem;background:var(--g-100);border:1.5px solid var(--line);\n  border-radius:12px;padding:.8rem 1rem;cursor:pointer;transition:border-color .15s,background .15s}\n.poll-opt:hover{border-color:var(--g-600);background:#fff}\n.poll-opt input{flex:none;width:18px;height:18px;accent-color:var(--g-700)}\n.poll-opt-text{flex:1;font-size:.95rem;font-weight:600}\n.poll-count{background:var(--g-800);color:#FBEEDD;font-size:.72rem;font-weight:800;padding:.2rem .6rem;border-radius:999px}\n.poll-name{padding:.7rem 1rem;border:1px solid var(--line);border-radius:12px;font:inherit;font-size:.88rem}\n.poll-results{margin-top:1rem}\n.poll-row{position:relative;margin-bottom:.55rem;border-radius:8px;overflow:hidden}\n.poll-bar{position:absolute;top:0;left:0;bottom:0;background:linear-gradient(90deg,var(--g-600),var(--g-700));opacity:.28;border-radius:8px;min-width:2px}\n.poll-bar-label{position:relative;display:block;padding:.5rem .8rem;font-size:.85rem;color:var(--ink)}\n.poll-bar-label b{color:var(--g-800)}\n.poll-total{text-align:center;color:var(--muted);font-size:.85rem;margin-top:.8rem}\n.poll-voted{background:var(--g-100);border:1px dashed var(--g-600);border-radius:12px;padding:.7rem 1rem;text-align:center;color:var(--g-800);font-size:.9rem}\n\n/* chart */\n.chart-bars{display:flex;gap:.9rem;align-items:flex-end;padding:1rem .5rem .2rem;min-height:110px}\n.chart-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;font-size:.62rem;color:var(--muted)}\n.chart-col small{white-space:nowrap;font-weight:700;font-size:.68rem;color:var(--muted)}\n.chart-num{font-size:.78rem;font-weight:800;color:var(--g-800);min-height:14px}\n.chart-bar{width:78%;min-height:4px;background:linear-gradient(180deg,var(--g-600),var(--g-800));border-radius:6px 6px 0 0;\n  box-shadow:0 -2px 10px rgba(217,119,6,.28);transition:height .6s ease;font-size:0}\n.chart-bar.empty{background:var(--line);box-shadow:none}\n.ev-row.bday{position:relative}\n.ev-row.bday::before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);width:4px;height:70%;background:var(--gold);border-radius:3px}\n.ev-row.bday div{padding-left:1rem}\n.btn-mini.cert{background:#EAD08B;color:#4A1E08}\n\n/* ============ LUXURY OPENING SPLASH ============ */\n.splash {\n  position: fixed; inset: 0; z-index: 9999;\n  display: grid; place-items: center; overflow: hidden;\n  background:\n    radial-gradient(ellipse at 50% 120%, rgba(180, 83, 9, .35), transparent 55%),\n    radial-gradient(ellipse at 50% -20%, rgba(201, 162, 39, .22), transparent 50%),\n    linear-gradient(160deg, #2B1207 0%, #3E1A08 40%, #2B1207 100%);\n  animation: splashIn 1s cubic-bezier(.22,1,.36,1);\n  transition: opacity .8s ease, visibility .8s;\n}\n.splash.hide { opacity: 0; visibility: hidden; pointer-events: none; }\n@keyframes splashIn { from { opacity: 0; } to { opacity: 1; } }\n\n.splash::before {\n  content: ""; position: absolute; inset: 0;\n  background-image:\n    radial-gradient(circle at 20% 30%, rgba(217,119,6,.12) 0, transparent 25%),\n    radial-gradient(circle at 80% 70%, rgba(201,162,39,.12) 0, transparent 25%);\n}\n/* jaali pattern */\n.splash::after {\n  content: ""; position: absolute; inset: 0; opacity: .05; pointer-events: none;\n  background-image: repeating-linear-gradient(45deg, #C9A227 0 1px, transparent 1px 14px),\n    repeating-linear-gradient(-45deg, #C9A227 0 1px, transparent 1px 14px);\n}\n.splash-particles { position: absolute; inset: 0; width: 100%; height: 100%; }\n\n.splash-mandala {\n  position: absolute; top: 50%; left: 50%; width: 150vmax; height: 150vmax;\n  transform: translate(-50%, -50%); opacity: .06; pointer-events: none;\n  background: conic-gradient(from 0deg, transparent 0deg, #C9A227 8deg, transparent 16deg,\n    transparent 45deg, #C9A227 53deg, transparent 61deg, transparent 90deg, #C9A227 98deg,\n    transparent 106deg, transparent 135deg, #C9A227 143deg, transparent 151deg,\n    transparent 180deg, #C9A227 188deg, transparent 196deg, transparent 225deg,\n    #C9A227 233deg, transparent 241deg, transparent 270deg, #C9A227 278deg,\n    transparent 286deg, transparent 315deg, #C9A227 323deg, transparent 331deg);\n  border-radius: 50%;\n  animation: mandalaSpin 60s linear infinite;\n  -webkit-mask: radial-gradient(circle, #000 30%, transparent 68%);\n  mask: radial-gradient(circle, #000 30%, transparent 68%);\n}\n@keyframes mandalaSpin { to { transform: translate(-50%, -50%) rotate(360deg); } }\n\n.splash-inner { position: relative; z-index: 2; text-align: center; padding: 1.5rem; max-width: 480px; width: 100%; }\n\n.splash-shlok {\n  color: #EAD08B; font-size: .85rem; letter-spacing: .3em; margin-bottom: 1.6rem;\n  opacity: 0; animation: fadeUp .9s ease .3s forwards;\n}\n\n.splash-logo-ring {\n  position: relative; width: 150px; height: 150px; margin: 0 auto 1.4rem;\n  animation: logoFloat 4s ease-in-out infinite;\n}\n@keyframes logoFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }\n.splash-logo {\n  position: absolute; inset: 14px; width: calc(100% - 28px); height: calc(100% - 28px);\n  border-radius: 50%; object-fit: cover;\n  box-shadow: 0 0 40px rgba(217,119,6,.55), 0 0 80px rgba(201,162,39,.3);\n  opacity: 0; animation: logoReveal 1.2s cubic-bezier(.22,1,.36,1) .5s forwards;\n}\n@keyframes logoReveal {\n  from { opacity: 0; transform: scale(.6) rotate(-20deg); filter: blur(10px); }\n  to { opacity: 1; transform: scale(1) rotate(0); filter: blur(0); }\n}\n.splash-ring { position: absolute; inset: 0; border-radius: 50%; }\n.splash-ring.r1 {\n  border: 2px solid rgba(234,208,139,.9);\n  animation: ringGrow 1s ease .4s both, ringPulse 3s ease-in-out 1.6s infinite;\n}\n.splash-ring.r2 {\n  inset: -10px; border: 1px dashed rgba(201,162,39,.6);\n  animation: ringGrow 1s ease .6s both, spinSlow 30s linear infinite;\n}\n@keyframes ringGrow { from { transform: scale(.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }\n@keyframes ringPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(217,119,6,.5); } 50% { box-shadow: 0 0 0 12px rgba(217,119,6,0); } }\n@keyframes spinSlow { to { transform: rotate(360deg); } }\n\n.splash-title { font-family: "Rozha One", Georgia, serif; line-height: 1.15; margin-bottom: .3rem; }\n.splash-title .line {\n  display: block; font-size: clamp(2rem, 9vw, 3.2rem); color: #FFF8E7;\n  text-shadow: 0 4px 30px rgba(0,0,0,.5);\n  opacity: 0; animation: fadeUp 1s cubic-bezier(.22,1,.36,1) .9s forwards;\n}\n.splash-title .line-gold {\n  color: transparent; font-size: clamp(2.3rem, 10vw, 3.6rem);\n  background: linear-gradient(105deg, #B45309 0%, #EAD08B 25%, #FFF1C9 40%, #C9A227 55%, #B45309 75%, #EAD08B 100%);\n  background-size: 200% auto; -webkit-background-clip: text; background-clip: text;\n  animation: fadeUp 1s cubic-bezier(.22,1,.36,1) 1.05s forwards, goldShine 3s linear 2s infinite;\n}\n@keyframes goldShine { to { background-position: 200% center; } }\n\n.splash-sub {\n  color: #EAD08B; letter-spacing: .55em; font-size: .72rem; text-transform: uppercase;\n  margin: .5rem 0 .3rem; padding-left: .55em; opacity: 0; animation: fadeUp .9s ease 1.25s forwards;\n}\n\n.splash-divider {\n  display: flex; align-items: center; gap: .8rem; max-width: 300px; margin: 1rem auto;\n  opacity: 0; animation: fadeUp .9s ease 1.4s forwards;\n}\n.splash-divider span { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #C9A227, transparent); }\n.splash-divider i { color: #EAD08B; font-style: normal; font-size: .9rem; }\n\n.splash-tag {\n  color: rgba(255,248,231,.75); font-size: .9rem; letter-spacing: .12em; margin-bottom: 1.6rem;\n  opacity: 0; animation: fadeUp .9s ease 1.55s forwards;\n}\n\n.splash-enter {\n  position: relative; overflow: hidden; cursor: pointer; border: 0;\n  font: inherit; font-weight: 800; font-size: 1.02rem; letter-spacing: .1em;\n  color: #2B1207; padding: 1rem 2.8rem; border-radius: 999px;\n  background: linear-gradient(120deg, #B45309, #EAD08B 45%, #FFF1C9 50%, #EAD08B 55%, #B45309);\n  background-size: 220% auto;\n  box-shadow: 0 12px 34px rgba(217,119,6,.45), 0 0 0 1px rgba(255,241,201,.6) inset;\n  transition: transform .2s ease, box-shadow .2s ease;\n  animation: fadeUp .9s ease 1.75s forwards, btnGlow 2.6s ease-in-out 2.5s infinite;\n  opacity: 0;\n}\n.splash-enter:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 16px 42px rgba(217,119,6,.6); }\n.splash-enter:active { transform: scale(.96); }\n@keyframes btnGlow {\n  0%,100% { box-shadow: 0 12px 34px rgba(217,119,6,.45); }\n  50% { box-shadow: 0 12px 44px rgba(234,208,139,.75); }\n}\n.splash-enter .btn-shine {\n  position: absolute; top: 0; left: -80%; width: 50%; height: 100%;\n  background: linear-gradient(105deg, transparent, rgba(255,255,255,.7), transparent);\n  transform: skewX(-20deg); animation: shine 2.8s ease-in-out 2.2s infinite;\n}\n@keyframes shine { 0%, 60% { left: -80%; } 100% { left: 130%; } }\n\n.splash-skip { color: rgba(255,248,231,.4); font-size: .75rem; margin-top: 1.4rem; letter-spacing: .1em; animation: fadeUp .9s ease 2.1s forwards; opacity: 0; }\n\n.splash-corner { position: absolute; width: 72px; height: 72px; border: 2px solid rgba(201,162,39,.55); z-index: 2; }\n.splash-corner.tl { top: 14px; left: 14px; border-right: 0; border-bottom: 0; }\n.splash-corner.tr { top: 14px; right: 14px; border-left: 0; border-bottom: 0; }\n.splash-corner.bl { bottom: 14px; left: 14px; border-right: 0; border-top: 0; }\n.splash-corner.br { bottom: 14px; right: 14px; border-left: 0; border-top: 0; }\n\n@keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }\n\n/* body lock while splash */\nbody.splash-lock { overflow: hidden; }\n\n@media (max-width: 480px) {\n  .splash-logo-ring { width: 120px; height: 120px; }\n  .splash-tag { font-size: .8rem; }\n  .splash-enter { font-size: .94rem; padding: .9rem 2.2rem; }\n}\n\n/* 5-second entrance progress bar */\n.splash-progress{\n  position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(255,241,201,.1);z-index:5;\n}\n.splash-progress span{\n  display:block;height:100%;width:0;\n  background:linear-gradient(90deg,#B45309,#EAD08B,#FFF1C9);\n  box-shadow:0 0 12px rgba(234,208,139,.8);\n  animation:splashProg 5s linear forwards;\n}\n@keyframes splashProg{from{width:0}to{width:100%}}\n\n/* ============ YATRA SECTION ============ */\n.yatra-banner{padding:.8rem 0 0}\n.yb-box{display:flex;align-items:center;justify-content:space-between;gap:1rem;\n  background:linear-gradient(135deg,#7C2D12,#B45309,#D97706);color:#FFF7E6;border-radius:18px;padding:1rem 1.2rem;\n  text-decoration:none;box-shadow:0 10px 30px rgba(180,83,9,.4);border-right:6px solid #FCD34D;\n  transition:transform .2s,box-shadow .2s}\n.yb-box:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(180,83,9,.5)}\n.yb-left{display:flex;align-items:center;gap:.9rem;min-width:0}\n.yb-flag{font-size:2rem;flex:none;filter:drop-shadow(0 3px 6px rgba(0,0,0,.3))}\n.yb-title{display:block;font-size:1.05rem;font-weight:800;letter-spacing:.01em}\n.yb-text small{display:block;font-size:.72rem;opacity:.85;margin-top:.15rem}\n.yb-right{display:flex;flex-direction:column;align-items:flex-end;gap:.3rem;flex:none}\n.yb-days{font-size:.8rem;opacity:.95}\n.yb-days b{font-size:1.5rem;color:#FCD34D;font-family:Georgia,serif}\n.yb-today{font-size:.85rem;font-weight:800;color:#FCD34D}\n.yb-cta{font-size:.72rem;opacity:.9;letter-spacing:.03em}\n\n/*hero*/\n.yatra-hero{position:relative;overflow:hidden;background:linear-gradient(160deg,#2B1207 0%,#431C08 45%,#2B1207 100%);\n  color:#FFF8E7;padding:3.5rem 0 3rem;text-align:center}\n.yatra-hero::before{content:"";position:absolute;inset:0;opacity:.06;pointer-events:none;\n  background-image:repeating-linear-gradient(45deg,#C9A227 0 1px,transparent 1px 16px),\n  repeating-linear-gradient(-45deg,#C9A227 0 1px,transparent 1px 16px)}\n.yatra-hero-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:600px;\n  background:radial-gradient(circle,rgba(217,119,6,.18) 0,transparent 70%);pointer-events:none}\n.yatra-hero-inner{position:relative;z-index:1}\n.yatra-shlok{color:#EAD08B;font-size:.82rem;letter-spacing:.2em;margin-bottom:.9rem}\n.yatra-title{font-family:"Rozha One",Georgia,serif;font-size:clamp(1.6rem,6vw,2.8rem);line-height:1.25;\n  background:linear-gradient(105deg,#FCD34D,#FFF1C9,#EAD08B);-webkit-background-clip:text;background-clip:text;\n  color:transparent;margin-bottom:.4rem}\n.yatra-place{font-size:.92rem;opacity:.85;margin-bottom:1.4rem}\n.yatra-date{display:inline-block;background:rgba(255,255,255,.08);border:1px solid rgba(255,241,201,.25);\n  padding:.4rem 1.2rem;border-radius:999px;font-size:.85rem;letter-spacing:.05em;margin-top:.8rem}\n.yatra-couns{margin-top:.6rem;font-size:.85rem;color:#FCD34D}\n.yatra-couns b{font-size:1.15rem}\n\n/*countdown*/\n.yatra-countdown{display:flex;align-items:center;justify-content:center;gap:.6rem;margin:1.2rem 0 .6rem}\n.yc-box{display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,.07);\n  border:1px solid rgba(234,208,139,.35);border-radius:14px;padding:.7rem .85rem;min-width:70px}\n.yc-num{font-family:Georgia,serif;font-size:1.7rem;font-weight:800;color:#FCD34D;line-height:1}\n.yc-lbl{font-size:.62rem;color:rgba(255,248,231,.7);margin-top:.3rem;text-transform:uppercase;letter-spacing:.1em}\n.yc-star{color:#C9A227;font-size:1rem}\n.yc-today{font-size:1rem;color:#FCD34D;font-weight:700}\n\n/*cards*/\n.yatra-2col{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem}\n@media(max-width:800px){.yatra-2col{grid-template-columns:1fr}}\n.yatra-card{background:#fff;border-radius:20px;border:1px solid var(--line);padding:1.8rem 1.5rem;box-shadow:var(--shadow-sm)}\n.yatra-about{text-align:center;max-width:620px;margin:0 auto}\n.yatra-about .yatra-ic{font-size:2.4rem;display:block;margin-bottom:.4rem}\n.yatra-about h2{font-size:1.3rem;margin-bottom:.5rem}\n.yatra-about p{color:var(--muted);line-height:1.75;font-size:.95rem}\n.yatra-card h2{font-size:1.15rem;margin-bottom:1rem;display:flex;align-items:center;gap:.5rem}\n.yatra-card h2 .yatra-ic{font-size:1.4rem}\n.yatra-plan{padding-left:1.3rem;display:grid;gap:.55rem}\n.yatra-plan li{color:var(--ink);font-size:.92rem;line-height:1.65;padding-left:.2rem;border-left:3px solid var(--g-200)}\n.yatra-check{list-style:none;display:grid;gap:.5rem}\n.yatra-check .ch{margin-right:.5rem;flex:none}\n.yatra-check li{display:flex;align-items:flex-start;color:var(--ink);font-size:.92rem;line-height:1.6}\n\n/*reg + who*/\n.yatra-reg-wrap{max-width:640px;margin:0 auto}\n.yatra-reg-head{text-align:center;margin-bottom:1.2rem}\n.yatra-reg-head h2{font-size:1.4rem;margin-bottom:.3rem}\n.yatra-reg-head p{color:var(--muted);font-size:.9rem}\n.yatra-count-pill{margin-top:.6rem;font-size:.82rem;color:var(--g-700)}\n.yatra-count-pill b{color:var(--g-800)}\n.yatra-who{background:#fff;border:1px solid var(--line);border-radius:18px;padding:1.3rem;margin-top:1.4rem}\n.yatra-who h3{font-size:1rem;margin-bottom:.8rem;color:var(--g-800)}\n.yatra-who-list{display:flex;flex-wrap:wrap;gap:.5rem}\n.yatra-who-chip{background:var(--g-100);border:1px solid rgba(217,119,6,.2);padding:.4rem .9rem;border-radius:999px;\n  font-size:.82rem;color:var(--ink);display:flex;align-items:center;gap:.3rem}\n.yatra-who-chip small{font-size:.68rem;color:var(--muted)}\n.yatra-who-chip.more{background:var(--g-700);color:#FBEEDD;border-color:var(--g-600)}\n\n.yatra-admin-row{display:flex;align-items:center;gap:.6rem;padding:.5rem .9rem;background:var(--g-100);\n  border:1px solid var(--line);border-radius:12px;font-size:.85rem}\n'
    fonts_css = ""
    for fdata, family, weight in (('', "Rozha One", "400"),
                                  ('', "Noto Deva", "100 900")):
        uri = "data:font/woff2;base64," + fdata
        fonts_css += ("@font-face{font-family:\"%s\";src:url(\"%s\") format(\"woff2\");"
                      "font-weight:%s;font-display:swap}\n" % (family, uri, weight))
    return {"STYLE": fonts_css + css,
            "SCRIPT": '/* वैष्णव बैरागी समाज — site scripts */\n(function () {\n  "use strict";\n\n  /* footer year */\n  var yr = document.getElementById("year");\n  if (yr) yr.textContent = new Date().getFullYear();\n\n  /* mobile nav */\n  var toggle = document.getElementById("navToggle");\n  var nav = document.getElementById("siteNav");\n  if (toggle && nav) {\n    toggle.addEventListener("click", function () { nav.classList.toggle("open"); });\n    nav.addEventListener("click", function (e) {\n      if (e.target.closest("a")) nav.classList.remove("open");\n    });\n  }\n\n  /* reveal on scroll */\n  var io = "IntersectionObserver" in window\n    ? new IntersectionObserver(function (entries) {\n        entries.forEach(function (en) {\n          if (en.isIntersecting) { en.target.classList.add("visible"); io.unobserve(en.target); }\n        });\n      }, { threshold: 0.12 })\n    : null;\n  document.querySelectorAll(".reveal").forEach(function (el) {\n    if (io) io.observe(el); else el.classList.add("visible");\n  });\n\n  /* animated counters */\n  function animateCount(el) {\n    var target = parseInt(el.getAttribute("data-count"), 10) || 0;\n    var dur = 1400, t0 = null;\n    function tick(now) {\n      if (!t0) t0 = now;\n      var p = Math.min((now - t0) / dur, 1);\n      var eased = 1 - Math.pow(1 - p, 3);\n      el.textContent = Math.round(target * eased).toLocaleString("en-IN");\n      if (p < 1) requestAnimationFrame(tick);\n    }\n    requestAnimationFrame(tick);\n  }\n  var seen = typeof WeakSet !== "undefined" ? new WeakSet() : null;\n  var cio = "IntersectionObserver" in window\n    ? new IntersectionObserver(function (entries) {\n        entries.forEach(function (en) {\n          if (en.isIntersecting && (!seen || !seen.has(en.target))) {\n            if (seen) seen.add(en.target);\n            animateCount(en.target);\n            cio.unobserve(en.target);\n          }\n        });\n      }, { threshold: 0.4 })\n    : null;\n  document.querySelectorAll(".stat-num[data-count]").forEach(function (el) {\n    if (cio) cio.observe(el); else animateCount(el);\n  });\n\n  /* ---------- member directory ---------- */\n  var grid = document.getElementById("memberGrid");\n  if (!grid) return;\n\n  var searchInput = document.getElementById("searchInput");\n  var stateFilter = document.getElementById("stateFilter");\n  var placeFilter = document.getElementById("placeFilter");\n  var professionFilter = document.getElementById("professionFilter");\n  var resultCount = document.getElementById("resultCount");\n  var emptyState = document.getElementById("emptyState");\n\n  function el(tag, cls, text) {\n    var n = document.createElement(tag);\n    if (cls) n.className = cls;\n    if (text !== undefined) n.textContent = text;\n    return n;\n  }\n\n  function pinSvg() {\n    var svgNS = "http://www.w3.org/2000/svg";\n    var svg = document.createElementNS(svgNS, "svg");\n    svg.setAttribute("viewBox", "0 0 20 20");\n    svg.setAttribute("width", "14"); svg.setAttribute("height", "14");\n    svg.setAttribute("fill", "none");\n    var p1 = document.createElementNS(svgNS, "path");\n    p1.setAttribute("d", "M10 18s6-5.2 6-9.5A6 6 0 0 0 4 8.5C4 12.8 10 18 10 18z");\n    p1.setAttribute("stroke", "currentColor"); p1.setAttribute("stroke-width", "1.6");\n    var c = document.createElementNS(svgNS, "circle");\n    c.setAttribute("cx", "10"); c.setAttribute("cy", "8.5"); c.setAttribute("r", "2.2");\n    c.setAttribute("stroke", "currentColor"); c.setAttribute("stroke-width", "1.6");\n    svg.appendChild(p1); svg.appendChild(c);\n    return svg;\n  }\n\n  function renderMembers(list) {\n    grid.innerHTML = "";\n    list.forEach(function (m) {\n      var card = el("article", "member-card");\n      var initial = (m.name || " ").trim().charAt(0);\n      card.appendChild(el("div", "member-avatar", initial));\n      card.appendChild(el("h3", "member-name", m.name));\n      var place = el("p", "member-place");\n      place.appendChild(pinSvg());\n      place.appendChild(document.createTextNode(\n        " " + m.village + (m.district ? ", " + m.district : "")));\n      card.appendChild(place);\n      var prof = (m.profession || "").split("/")[0].trim();\n      card.appendChild(el("span", "member-prof", prof));\n      if (m.details) {\n        var d = el("p", "member-details");\n        d.style.cssText = "color:#57705F;font-size:.85rem;margin-top:.6rem;";\n        d.textContent = m.details;\n        card.appendChild(d);\n      }\n      grid.appendChild(card);\n    });\n  }\n\n  var timer = null;\n  function fetchMembers() {\n    var params = new URLSearchParams();\n    if (searchInput.value.trim()) params.set("q", searchInput.value.trim());\n    if (stateFilter.value) params.set("state", stateFilter.value);\n    if (placeFilter && placeFilter.value) params.set("place", placeFilter.value);\n    if (professionFilter.value) params.set("profession", professionFilter.value);\n    resultCount.textContent = "खोजा जा रहा है…";\n    fetch("/api/members?" + params.toString(), { headers: { Accept: "application/json" } })\n      .then(function (r) { return r.json(); })\n      .then(function (list) {\n        resultCount.innerHTML = "कुल <b>" + list.length.toLocaleString("en-IN") +\n          "</b> सदस्य मिले · <b>" + list.length + "</b> members found";\n        emptyState.hidden = list.length !== 0;\n        renderMembers(list);\n      })\n      .catch(function () {\n        resultCount.textContent = "लोड करने में समस्या — पुनः प्रयास करें।";\n      });\n  }\n  function debounced() { clearTimeout(timer); timer = setTimeout(fetchMembers, 280); }\n\n  searchInput.addEventListener("input", debounced);\n  stateFilter.addEventListener("change", fetchMembers);\n  if (placeFilter) placeFilter.addEventListener("change", fetchMembers);\n  professionFilter.addEventListener("change", fetchMembers);\n  fetchMembers();\n})();\n\n/* ---------- मराठी / हिंदी toggle ---------- */\n(function () {\n  var LANG_KEY = "vbms_lang";\n  var MAR = {\n    "होम":"मुखपृष्ठ","परिचय":"आमचा परिचय","सदस्य सूची":"सदस्य यादी","कार्यकारिणी":"कार्यकारिणी",\n    "फोटो":"छायाचित्र","कार्यक्रम":"कार्यक्रम","संपर्क":"संपर्क","सदस्य बनें ✦":"सदस्या व्हा ✦",\n    "सदस्यता पंजीकरण":"सदस्यता नोंदणी","पंजीकरण जमा करें ✦ Submit Registration":"नोंदणी पाठवा ✦",\n    "महाराष्ट्र की वैष्णव बैरागी बहनों के लिए निःशुल्क पंजीकरण।":"महाराष्ट्रातील वैष्णव बैरागी बहिणींसाठी मोफत नोंदणी.",\n    "एक परिवार,":"एक कुटुंब,","एक पहचान":"एक ओळख","बहनों की एकता • सेवा • भक्ति":"बहिनींची एकता • सेवा • भक्ती",\n    "पूरा नाम":"पूर्ण नाव","गाँव / शहर":"गाव / शहर","जिला":"जिल्हा","राज्य":"राज्य",\n    "पेशा / व्यवसाय":"व्यवसाय","मोबाइल नंबर":"मोबाईल नंबर","ईमेल":"ईमेल",\n    "सदस्य खोजें":"सदस्य शोधा","आगामी कार्यक्रम":"आगामी कार्यक्रम","अधिवेशन और सत्संग":"अधिवेशन आणि सत्संग",\n    "सदस्य निर्देशिका":"सदस्य निर्देशिका","समाज परिवार":"समाज कुटुंब","नुकत्याच जुळालेल्या बहिनी":"नुकत्याच जुळालेल्या बहिणी",\n    "शुभकामनाएँ! Welcome":"शुभेच्छा! स्वागत","सूचना":"सूचना","🏠 होम":"🏠 मुखपृष्ठ",\n    "सभी गाँव · All Places":"सर्व गावे","सभी जिल्हे · All Districts":"सर्व जिल्हे",\n    "सभी पेशे · All Professions":"सर्व व्यवसाय","सभी राज्य · All States":"सर्व राज्ये",\n    "संदेश भेजें · Send message":"संदेश पाठवा","संदेश भेजें":"संदेश पाठवा","त्वरित लिंक · Links":"द्रुत लिंक",\n    "फोटो गॅलरी":"छायाचित्र गॅलरी","वैष्णव बैरागी महिला समाज":"वैष्णव बैरागी महिला समाज"\n  };\n  var REV = {};\n  Object.keys(MAR).forEach(function (k) { REV[MAR[k]] = k; });\n\n  function translate(map) {\n    var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT,\n      { acceptNode: function (n) {\n          var t = n.nodeValue.trim();\n          return (t && map[t]) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;\n        }});\n    var node;\n    while ((node = walker.nextNode())) {\n      var t = node.nodeValue.trim();\n      if (map[t]) node.nodeValue = node.nodeValue.replace(t, map[t]);\n    }\n  }\n  function setLang(l) {\n    try { localStorage.setItem(LANG_KEY, l); } catch (e) {}\n  }\n  window.addEventListener("DOMContentLoaded", function () {\n    var lang = "hi";\n    try { lang = localStorage.getItem(LANG_KEY) || "hi"; } catch (e) {}\n    var btn = document.getElementById("langToggle");\n    if (btn) {\n      btn.textContent = lang === "mr" ? "🇮🇳 हिंदी" : "🚩 मराठी";\n      btn.addEventListener("click", function () {\n        var cur = (function(){ try { return localStorage.getItem(LANG_KEY) || "hi"; } catch(e){ return "hi"; } })();\n        if (cur === "mr") { setLang("hi"); translate(REV); btn.textContent = "🚩 मराठी"; }\n        else { setLang("mr"); translate(MAR); btn.textContent = "🇮🇳 हिंदी"; }\n      });\n    }\n    if (lang === "mr") translate(MAR);\n  });\n})();\n\n/* ---------- Luxury opening splash ---------- */\n(function () {\n  var splash = document.getElementById("splash");\n  if (!splash) return;\n\n  // sirf ek baar per session\n  try {\n    if (sessionStorage.getItem("vbms_seen")) { splash.remove(); return; }\n  } catch (e) {}\n\n  document.body.classList.add("splash-lock");\n\n  /* gold float particles */\n  var cvs = document.getElementById("splashParticles");\n  if (cvs && cvs.getContext) {\n    var ctx = cvs.getContext("2d"), W, H, ps = [];\n    function size() { W = cvs.width = cvs.offsetWidth; H = cvs.height = cvs.offsetHeight; }\n    size(); window.addEventListener("resize", size);\n    function spawn() {\n      return { x: Math.random() * W, y: Math.random() * H,\n        r: .8 + Math.random() * 2.2, vy: .3 + Math.random() * .8,\n        vx: (Math.random() - .5) * .3, o: .15 + Math.random() * .5,\n        p: Math.random() * 6.28 };\n    }\n    for (var i = 0; i < (window.innerWidth < 767 ? 40 : 70); i++) ps.push(spawn());\n    var raf;\n    function tick() {\n      ctx.clearRect(0, 0, W, H);\n      for (var i = 0; i < ps.length; i++) {\n        var p = ps[i];\n        p.y -= p.vy; p.x += p.vx; p.p += .02;\n        if (p.y < -10) { p.y = H + 10; p.x = Math.random() * W; }\n        var glow = p.o + Math.sin(p.p) * .2;\n        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.28);\n        ctx.fillStyle = "rgba(255, 220, 150, " + Math.max(glow, .05).toFixed(2) + ")";\n        ctx.fill();\n      }\n      raf = requestAnimationFrame(tick);\n    }\n    tick();\n    splash._stop = function () { cancelAnimationFrame(raf); };\n  }\n\n  function close() {\n    if (splash._closed) return;\n    splash._closed = true;\n    try { sessionStorage.setItem("vbms_seen", "1"); } catch (e) {}\n    splash.classList.add("hide");\n    document.body.classList.remove("splash-lock");\n    if (splash._stop) splash._stop();\n    setTimeout(function () { splash.remove(); }, 900);\n  }\n  var btn = document.getElementById("splashEnter");\n  if (btn) btn.addEventListener("click", function (e) { e.stopPropagation(); close(); });\n  splash.addEventListener("click", close);\n  // auto-close after exactly 5 seconds\n  var auto = setTimeout(close, 5000);\n  splash.addEventListener("click", function () { clearTimeout(auto); });\n})();\n',
            "LOGO": "data:image/png;base64," + ''}

