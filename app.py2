# ---------------------------------------------------------------- database
# Turso (permanent cloud DB — FREE) agar env vars set hon toh use hota hai;
# warna local SQLite (testing/deploy ke shuru ke liye).
TURSO_URL = os.environ.get("TURSO_DATABASE_URL", "").strip()
TURSO_TOKEN = os.environ.get("TURSO_AUTH_TOKEN", "").strip()
USE_TURSO = bool(TURSO_URL)

class DBRow(dict):
    """sqlite3.Row jaisa — dict + integer index dono access."""
    def __getitem__(self, k):
        if isinstance(k, int):
            return list(self.values())[k]
        return super().__getitem__(k)

class _Cursor:
    def __init__(self, rows): self._rows = rows
    def fetchone(self): return self._rows[0] if self._rows else None
    def fetchall(self): return list(self._rows)

class _TursoDB:
    """libsql (Turso) ko hamari app ke purane API ke hisaab se chalata hai."""
    def __init__(self):
        import libsql_client
        self._c = libsql_client.create_client_sync(TURSO_URL, auth_token=TURSO_TOKEN or None)
    def execute(self, sql, args=()):
        rs = self._c.execute(sql, list(args))
        cols = [str(c) for c in rs.columns]
        return _Cursor([DBRow(zip(cols, list(r))) for r in rs.rows])
    def executemany(self, sql, seq):
        for a in seq:
            self._c.execute(sql, list(a))
    def executescript(self, script):
        for part in script.split(";"):
            part = part.strip()
            if part:
                self._c.execute(part)
    def commit(self):  # Turso autocommit hai
        pass
    def close(self):
        try: self._c.close()
        except Exception: pass

def _db_open():
    if USE_TURSO:
        return _TursoDB()
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    return conn

def get_db():
    if "db" not in g:
        g.db = _db_open()
    return g.db

@app.teardown_appcontext
def close_db(_):
    db = g.pop("db", None)
    if db is not None:
        db.close()

